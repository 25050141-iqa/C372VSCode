<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Booking History</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Booking History</h2>

    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success"><%= messages[0] %></div>
    <% } %>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger"><%= errors[0] %></div>
    <% } %>

    <div class="mb-3">
      <a href="/services" class="btn btn-primary">Book a Service</a>
    </div>

    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Booking ID</th>
          <th>Date</th>
          <th>Pet</th>
          <th>Service</th>
          <th>Price</th>
          <th>Booking Status</th>
          <th>Payment Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!bookings || bookings.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center">No booking history found.</td>
          </tr>
        <% } else { %>
          <% bookings.forEach((booking) => { %>
            <tr>
              <td><%= booking.booking_id %></td>
              <td><%= booking.booking_date %></td>
              <td><%= booking.pet_name %></td>
              <td><%= booking.service_name %></td>
              <td>S$<%= Number(booking.booked_price).toFixed(2) %></td>
              <td><%= booking.booking_status %></td>
              <td><%= booking.payment_status || 'No payment record' %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
