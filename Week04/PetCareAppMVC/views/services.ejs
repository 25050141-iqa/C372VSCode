<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pet Services</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Book a Service</h2>

    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success"><%= messages[0] %></div>
    <% } %>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger"><%= errors[0] %></div>
    <% } %>

    <% if (pets && pets.length === 0) { %>
      <div class="alert alert-warning">
        You do not have any pets yet.
        <a href="/pets/new" class="alert-link">Add a pet</a> to continue.
      </div>
    <% } else { %>
      <form action="/services/book" method="POST">
        <div class="mb-3">
          <label class="form-label">Choose your pet</label>
          <select name="petId" class="form-select" required>
            <option value="">-- Select a pet --</option>
            <% pets.forEach((pet) => { %>
              <option value="<%= pet.id %>" <%= String(selectedPetId) === String(pet.id) ? 'selected' : '' %>>
                <%= pet.name %> (<%= pet.species %>)
              </option>
            <% }); %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label">Choose a service</label>

          <% if (services && services.length === 0) { %>
            <div class="alert alert-info">No services are currently available.</div>
          <% } else { %>
            <div class="list-group">
              <% services.forEach((service) => { %>
                <label class="list-group-item d-flex justify-content-between align-items-center">
                  <span>
                    <input type="radio" name="serviceId" value="<%= service.id %>" required>
                    <span class="ms-2"><%= service.name %></span>
                  </span>
                  <span class="badge bg-primary rounded-pill">S$<%= Number(service.price).toFixed(2) %></span>
                </label>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="bookingDate" class="form-label">Booking date</label>
          <input
            id="bookingDate"
            type="date"
            name="bookingDate"
            class="form-control"
            min="<%= today %>"
            required
          >
        </div>

        <button type="submit" class="btn btn-primary" <% if (!pets.length || !services.length) { %>disabled<% } %>>Book Service</button>
      </form>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
